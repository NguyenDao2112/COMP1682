<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer ring -->
    <item>
        <shape android:shape="oval">
            <stroke android:width="4dp" android:color="@color/color_primary_green" />
            <size android:width="88dp" android:height="88dp" />
        </shape>
    </item>
    <!-- Inner circle -->
    <item android:top="10dp" android:bottom="10dp" android:left="10dp" android:right="10dp">
        <shape android:shape="oval">
            <solid android:color="@color/color_primary_green" />
        </shape>
    </item>
</layer-list>
