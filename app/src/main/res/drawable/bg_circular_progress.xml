<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="ring" android:thickness="4dp" android:useLevel="false">
            <solid android:color="@color/slate_100" />
        </shape>
    </item>
    <item>
        <rotate android:fromDegrees="270" android:toDegrees="270">
            <shape android:shape="ring" android:thickness="4dp" android:useLevel="true">
                <gradient android:endColor="@color/color_primary_green" android:startColor="@color/color_primary_green" android:type="sweep" />
            </shape>
        </rotate>
    </item>
</layer-list>
