<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state with soft Emerald Green -->
    <item android:state_focused="true">
        <shape>
            <solid android:color="#0F172A" />
            <stroke android:width="2dp" android:color="#10B981" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- Default state (unfocused) with soft Slate -->
    <item>
        <shape>
            <solid android:color="#1E293B" />
            <stroke android:width="1dp" android:color="#334155" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
